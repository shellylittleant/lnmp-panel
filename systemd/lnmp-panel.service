[Unit]
Description=LNMP 面板
After=network.target nftables.service
Wants=nftables.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/local/bin/lnmp-panel run --config /etc/lnmp-panel/panel.json
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
