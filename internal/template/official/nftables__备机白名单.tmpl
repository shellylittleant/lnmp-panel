flush ruleset

table inet lnmp_panel {
	set login_ban {
		type ipv4_addr
		flags timeout
		timeout 30m
	}
	set login_ban6 {
		type ipv6_addr
		flags timeout
		timeout 30m
	}
	set allow_ips {
		type ipv4_addr
		flags interval
{{if .AllowCIDRs}}		elements = { {{join .AllowCIDRs ", "}} }
{{end}}	}
	set peer_ips {
		type ipv4_addr
		flags interval
{{if .PeerCIDRs}}		elements = { {{join .PeerCIDRs ", "}} }
{{end}}	}

	chain input {
		type filter hook input priority 0; policy drop;
		ct state established,related accept
		ct state invalid drop
		meta l4proto { icmp, ipv6-icmp } accept
		iif lo accept
		ip saddr @login_ban drop
		ip6 saddr @login_ban6 drop
		tcp dport { 80, 443 } accept
{{if .AllowCIDRs}}{{range .SSHPorts}}		tcp dport {{.}} ip saddr @allow_ips accept comment "ssh"
{{end}}		tcp dport {{.PanelPort}} ip saddr @allow_ips accept comment "panel-ops"
{{else}}{{range .SSHPorts}}		tcp dport {{.}} accept comment "ssh"
{{end}}		tcp dport {{.PanelPort}} accept comment "panel"
{{end}}{{if .PeerCIDRs}}		tcp dport {{.PanelPort}} ip saddr @peer_ips accept comment "panel-peer"
{{end}}{{range .OpenPorts}}		tcp dport {{.}} accept
{{end}}{{range .UDPPorts}}		udp dport {{.}} accept
{{end}}	}

	chain forward {
		type filter hook forward priority 0; policy drop;
	}

	chain output {
		type filter hook output priority 0; policy accept;
	}
}
