flush ruleset

table inet lnmp_panel {
	set login_ban {
		type ipv4_addr
		flags timeout
		timeout 30m
	}
	set allow_ips {
		type ipv4_addr
		flags interval
{{if .AllowCIDRs}}		elements = { {{join .AllowCIDRs ", "}} }
{{end}}	}

	chain input {
		type filter hook input priority 0; policy {{.InputPolicy}};
		ct state established,related accept
		iif lo accept
		ip saddr @login_ban drop
		tcp dport {{.SSHPort}} accept comment "ssh"
		tcp dport {{.PanelPort}} accept comment "panel"
{{if .PublicHTTP}}		tcp dport { 80, 443 } accept
{{end}}{{range .OpenPorts}}		tcp dport {{.}} accept
{{end}}{{range .UDPPorts}}		udp dport {{.}} accept
{{end}}{{if .AllowCIDRs}}		ip saddr @allow_ips accept
{{end}}	}

	chain forward {
		type filter hook forward priority 0; policy drop;
	}

	chain output {
		type filter hook output priority 0; policy accept;
	}
}
