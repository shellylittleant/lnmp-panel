/var/log/nginx/*.log
/var/log/lnmp-panel/*.log
/var/log/mysql/*.log
/var/log/php*-fpm.log
{
	daily
	rotate {{.KeepDays}}
	maxsize {{.MaxSize}}
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		[ -s /run/nginx.pid ] && kill -USR1 $(cat /run/nginx.pid) 2>/dev/null || true
	endscript
}
