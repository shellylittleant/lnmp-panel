server {
    listen 80;
{{if .SSLCert}}    listen 443 ssl{{if .HTTP2}} http2{{end}};
{{end}}    server_name {{join .Domains " "}};
    root {{.Root}};
    index index.php index.html;
    access_log /var/log/nginx/{{.SiteKey}}.access.log lnmp_panel;
    error_log /var/log/nginx/{{.SiteKey}}.error.log;

    location /.well-known/acme-challenge/ {
        alias /var/lib/lnmp-panel/acme-www/;
        default_type text/plain;
    }
{{if .SSLCert}}
{{indent 4 .SSLSnippet}}
{{end}}{{if .AccessAllow}}
{{range .AccessAllow}}    allow {{.}};
{{end}}    deny all;
{{end}}{{if .BasicAuthFile}}    auth_basic "restricted";
    auth_basic_user_file {{.BasicAuthFile}};
{{end}}{{range .Redirects}}    location = {{.FromPath}} { return {{.Code}} {{.ToURL}}; }
{{end}}{{if .Rewrite}}
{{indent 4 .Rewrite}}
{{else}}    location / {
        try_files $uri $uri/ {{if .PHPSocket}}/index.php?$query_string{{else}}=404{{end}};
    }
{{end}}{{if .PHPSocket}}    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:{{.PHPSocket}};
    }
{{end}}{{if .Hotlink}}    location ~* \.(gif|jpg|jpeg|png|webp)$ {
        valid_referers none blocked server_names {{join .Hotlink " "}};
        if ($invalid_referer) { return 403; }
    }
{{end}}}
