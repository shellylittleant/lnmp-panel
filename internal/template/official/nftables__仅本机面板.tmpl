flush ruleset

table inet lnmp_panel {
	set login_ban {
		type ipv4_addr
		flags timeout
		timeout 30m
	}

	chain input {
		type filter hook input priority 0; policy drop;
		ct state established,related accept
		iif lo accept
		ip saddr @login_ban drop
		tcp dport {{.SSHPort}} accept comment "ssh"
		tcp dport {{.PanelPort}} ip saddr 127.0.0.1 accept comment "panel-local"
{{if .PublicHTTP}}		tcp dport { 80, 443 } accept
{{end}}	}

	chain forward {
		type filter hook forward priority 0; policy drop;
	}

	chain output {
		type filter hook output priority 0; policy accept;
	}
}
